# Public DNS name. Point its A/AAAA record to this host before deployment.
APP_DOMAIN=robot.example.com
ACME_EMAIL=operator@example.com
CADDYFILE=./Caddyfile

APP_ENV=production
FRONTEND_URL=https://robot.example.com
CORS_ALLOWED_ORIGINS=https://robot.example.com
TRUSTED_HOSTS=robot.example.com
SESSION_COOKIE_SECURE=true
SESSION_TTL_SECONDS=43200

POSTGRES_DB=indoor_delivery
POSTGRES_USER=indoor_delivery
POSTGRES_PASSWORD=replace-with-a-random-database-password
DATABASE_URL=postgresql+psycopg://indoor_delivery:replace-with-url-encoded-password@postgres:5432/indoor_delivery

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-16-random-characters

ROBOT_WS_AUTH_REQUIRED=true
ALLOW_LEGACY_ROBOT_TOKEN=false
ROBOT_ENROLLMENT_ENABLED=true
ROBOT_ENROLLMENT_TOKEN=replace-with-at-least-32-random-characters
ROBOT_ENROLLMENT_TTL_SECONDS=600
ROBOT_ENROLLMENT_RATE_LIMIT=6
ROBOT_ENROLLMENT_RATE_WINDOW_SECONDS=60

EMERGENCY_COMMAND_TIMEOUT_SECONDS=10
MAP_COMMAND_TIMEOUT_SECONDS=10
PASSWORD_MIN_LENGTH=12

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://robot.example.com/api/auth/google/callback
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
PASSWORD_RESET_URL_BASE=https://robot.example.com/reset-password
