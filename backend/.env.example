DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/indoor_delivery
APP_ENV=development
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=<set-a-strong-local-password>
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=43200
ROBOT_WS_TOKEN=<set-a-random-token>
ROBOT_WS_AUTH_REQUIRED=true
EMERGENCY_COMMAND_TIMEOUT_SECONDS=10
